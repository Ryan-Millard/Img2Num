{
  "compilerOptions": {
    // Runtime: Node.js ESM, with no browser globals in scope
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // Type checking: `strict`, plus every type-checking option that `strict` leaves off
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // Modules: imports are written exactly as they run, and every one of them has to resolve
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,

    // Syntax: only types that Node.js can strip (no enums, namespaces, ...)
    "erasableSyntaxOnly": true,

    // Exports need explicit types (`isolatedDeclarations` requires `declaration`; nothing is emitted)
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true,

    // Declaration files are type-checked too, including the ones `img2num` ships
    "skipLibCheck": false
  },
  "include": ["index.ts"]
}
