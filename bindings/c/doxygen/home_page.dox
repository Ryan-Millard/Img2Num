/*! \mainpage Img2Num C Bindings
 *
 * \section intro_sec Introduction
 *
 * The **Img2Num C Bindings** provide a C-friendly interface to the core Img2Num
 * image processing library. These bindings wrap the underlying C++ functionality
 * using `extern "C"` to allow C projects to access advanced image processing
 * operations, including filtering, clustering, thresholding, and SVG conversion.
 *
 * All functions operate on raw image buffers (`uint8_t*`) and provide a simple,
 * low-level interface suitable for integration into C applications.
 *
 * \section features_sec Key Features
 *
 * The below are `extern "C"` wrappers around the `core/` library's functions:
 * - **FFT-based Gaussian blur** — Fast frequency-domain blurring
 * - **Image inversion** — Invert pixel values in-place
 * - **Thresholding** — Apply standard and black-thresholding operations
 * - **K-means clustering** — Pixel clustering for color quantization
 * - **Bilateral filtering** — Edge-preserving smoothing
 * - **SVG label rendering** — Convert labeled images to scalable vector graphics
 *
 * \section building_sec Building the C Bindings
 *
 * The C bindings are built using CMake from the project root:
 *
 * \code{.sh}
 * cmake -B build .
 * cmake --build build
 * \endcode
 *
 * \section install_sec Installation
 *
 * Install the library and headers to your system:
 *
 * \code{.sh}
 * cmake --install build
 * \endcode
 *
 * - **Libraries** are installed to `lib/`
 * - **Headers** are installed to `include/cimg2num/`
 *
 * Link against `CImg2Num` in your CMake project:
 *
 * \code{.cmake}
 * find_package(CImg2Num REQUIRED)
 * target_link_libraries(your_app PRIVATE CImg2Num::CImg2Num)
 * \endcode
 *
 * \section usage_sec Usage Example
 *
 * \warning **Buffer Format Requirement:** All Img2Num C functions expect a 32-bit
 * **RGBA buffer** (4 bytes per pixel: Red, Green, Blue, Alpha) in row-major order.
 * A buffer of dimensions `width * height` requires `(size_t)width * (size_t)height * 4`
 * bytes. Passing RGB (3 bytes/pixel) or grayscale (1 byte/pixel) buffers will cause
 * buffer overflow and memory corruption.
 *
 * \subsection memory_sec Memory Ownership
 * Functions that return strings, such as img2num_image_to_svg() and
 * img2num_labels_to_svg(), allocate the returned `char*` via `malloc()`.
 * **The caller owns the returned string and must release it using `free()`.**
 *
 * \subsection error_sec Error Handling
 * When a function fails (e.g. returns `NULL`), error details can be retrieved
 * using img2num_get_last_error() and img2num_get_last_error_message() from
 * `<cimg2num/img2num_error_t.h>`. Use img2num_clear_last_error() to reset the error state.
 *
 * \code{.c}
 * #include <cimg2num.h>
 * #include <cimg2num/img2num_error_t.h>
 * #include <stdio.h>
 * #include <stdlib.h>
 *
 * int main(void) {
 *     const int width = 256, height = 256;
 *
 *     /* RGBA: 4 bytes per pixel */
 *     uint8_t* image = calloc((size_t)width * (size_t)height * 4, 1);
 *     if (!image) return 1;
 *
 *     /* ... fill `image` with your pixel data ... */
 *
 *     img2num_ImageToSvgConfig config = img2num_ImageToSvgConfig_default();
 *     char* svg = img2num_image_to_svg(image, width, height, &config);
 *     if (!svg) {
 *         fprintf(stderr, "img2num: %s\n", img2num_get_last_error_message());
 *         free(image);
 *         return 1;
 *     }
 *
 *     puts(svg);
 *     free(svg);   /* the caller owns the returned string */
 *     free(image);
 *     return 0;
 * }
 * \endcode
 *
 * For complete working examples, see the `example-apps/console-c/` directory.
 *
 * \section api_sec API Reference
 *
 * Browse the detailed function documentation:
 * - \ref CIMG2NUM_H "Core C API Functions"
 */
