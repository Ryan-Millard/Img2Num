# Dependencies
node_modules

# Static files
# --- Doxygen (requires folder to exist, hence .gitkeep) ---
/static/docs/internal/**/api/*
!/static/docs/internal/**/api/.gitkeep
# C++ Doxygen
/static/docs/cpp/api/*
!/static/docs/cpp/api/.gitkeep
# C Doxygen
/static/docs/c/api/*
!/static/docs/c/api/.gitkeep
# --- Example/demo apps ---
/static/example-apps/*

# Production
/build

# Generated files
/.docusaurus
/.cache-loader

# Misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Auto-generated API docs
/docs/js/api/
/static/js/api.json

# Auto-generated Changelogs
/changelog/*
!/changelog/.gitkeep
