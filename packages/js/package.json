{
  "name": "img2num",
  "version": "0.4.2",
  "description": "Img2Num is a raster vectorization library - it converts images to SVGs",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "img2num",
    "computer-vision",
    "vectorization",
    "image-to-svg",
    "wasm",
    "webgpu"
  ],
  "homepage": "https://github.com/Ryan-Millard/Img2Num#readme",
  "bugs": {
    "url": "https://github.com/Ryan-Millard/Img2Num/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryan-Millard/Img2Num.git",
    "directory": "packages/js"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Ryan-Millard"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/ryan_millard"
    }
  ],
  "license": "MIT",
  "author": "Ryan-Millard",
  "type": "module",
  "main": "./dist/node/img2num.cjs",
  "types": "./dist/types/esm/index.d.ts",
  "module": "./dist/browser/img2num.js",
  "browser": "./dist/browser/img2num.js",
  "unpkg": "./dist/standalone/img2num.iife.js",
  "jsdelivr": "./dist/standalone/img2num.iife.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/browser/img2num.js"
      },
      "node": {
        "import": {
          "types": "./dist/types/esm/index.d.ts",
          "default": "./dist/node/img2num.js"
        },
        "require": {
          "types": "./dist/types/cjs/index.d.ts",
          "default": "./dist/node/img2num.cjs"
        }
      },
      "default": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/browser/img2num.js"
      }
    },
    "./wasm": "./dist/browser/img2num.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.wasm",
    "**/build-wasm/**"
  ],
  "scripts": {
    "build:browser": "cross-env TARGET=browser vite build",
    "build:standalone": "cross-env TARGET=standalone vite build",
    "build:node-esm": "cross-env TARGET=node-esm vite build",
    "build:node-cjs": "cross-env TARGET=node-cjs vite build",
    "build:node": "pnpm build:node-esm && pnpm build:node-cjs",
    "check:package": "publint",
    "build:types:esm": "tsc -p tsconfig.types.json --outDir dist/types/esm",
    "build:types:cjs": "tsc -p tsconfig.types.json --outDir dist/types/cjs && node scripts/mark-cjs-types.js",
    "build:types": "pnpm build:types:esm && pnpm build:types:cjs",
    "build": "pnpm build:browser && pnpm build:standalone && pnpm build:node && pnpm build:types",
    "test:types": "tsc -p test-types/tsconfig.json && tsc -p test-types/tsconfig.nodenext.json"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "webgpu": "^0.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "cross-env": "^10.1.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
