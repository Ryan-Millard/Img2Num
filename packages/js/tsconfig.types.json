{
  "compilerOptions": {
    "rootDir": "src",
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types/esm",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"]
}
